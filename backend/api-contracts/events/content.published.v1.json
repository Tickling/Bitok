{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bitok.app/content/published/v1.json",
  "title": "NewContentPublished",
  "description": "data для CloudEvent type = content.published",
  "type": "object",
  "required": [
    "contentId",
    "kind",
    "authorId",
    "title"
  ],
  "properties": {
    "contentId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "NEWS",
        "LESSON"
      ]
    },
    "authorId": {
      "type": "string",
      "format": "uuid"
    },
    "clubId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    }
  },
  "additionalProperties": true
}