{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bitok.app/achievement/unlocked/v1.json",
  "title": "AchievementUnlocked",
  "description": "data для CloudEvent type = achievement.unlocked",
  "type": "object",
  "required": [
    "studentId",
    "code",
    "rarity"
  ],
  "properties": {
    "studentId": {
      "type": "string",
      "format": "uuid"
    },
    "code": {
      "type": "string"
    },
    "rarity": {
      "enum": [
        "COMMON",
        "RARE",
        "EPIC",
        "LEGENDARY"
      ]
    },
    "rewardItemId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": true
}