{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bitok.app/payment/succeeded/v1.json",
  "title": "PaymentSucceeded",
  "description": "data для CloudEvent type = payment.succeeded",
  "type": "object",
  "required": [
    "paymentId",
    "bookingId",
    "amount",
    "paidAt"
  ],
  "properties": {
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "bookingId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "object",
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "RUB"
        }
      }
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}